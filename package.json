{
  "name": "heirloom",
  "version": "1.0.0",
  "private": true,
  "description": "家中物品来历册 - 为旧家具、纪念品、票据和手稿建立带图片/文字/音频的家庭档案",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @heirloom/api --filter @heirloom/web dev",
    "build": "pnpm --filter @heirloom/shared build && pnpm --filter @heirloom/api build && pnpm --filter @heirloom/web build && pnpm --filter @heirloom/migrator build",
    "start": "node apps/api/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @heirloom/shared test && pnpm --filter @heirloom/api test && pnpm --filter @heirloom/migrator test",
    "migrate:demo": "pnpm --filter @heirloom/migrator demo",
    "migrate:cli": "pnpm --filter @heirloom/migrator cli --",
    "db:migrate": "pnpm --filter @heirloom/api db:migrate",
    "db:deploy": "pnpm --filter @heirloom/api db:deploy",
    "db:studio": "pnpm --filter @heirloom/api db:studio",
    "db:init": "bash scripts/pg.sh init",
    "db:start": "bash scripts/pg.sh start",
    "db:stop": "bash scripts/pg.sh stop",
    "db:status": "bash scripts/pg.sh status",
    "db:psql": "bash scripts/pg.sh psql",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "backup:drill": "bash scripts/drill.sh",
    "gc": "bash scripts/gc.sh",
    "verify:loop": "bash scripts/verify-loop.sh",
    "test:ui": "node e2e/ui-smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0"
  }
}
